# SkillBridge AI Environment Variables
PORT=3000
ADMIN_EMAIL=Admin123@gmail.com
ADMIN_PASSWORD=your_secure_admin_password
SESSION_SECRET=your_random_session_secret_hex

# AI Service (Groq API)
GROQ_API_KEY=your_groq_api_key_here
AI_API_KEY=your_groq_api_key_here
AI_MODEL=openai/gpt-oss-20b

# Source Adapters Enable/Disable
GREENHOUSE_ENABLED=true
LEVER_ENABLED=true
ASHBY_ENABLED=true
REMOTIVE_ENABLED=true

# Approved Partner APIs (Require Official Partner Credentials)
# Scraping, CAPTCHA bypass, and automated logins are strictly prohibited.
LINKEDIN_APPROVED_API_ENABLED=false
LINKEDIN_API_KEY=
LINKEDIN_API_SECRET=
INTERNSHALA_APPROVED_API_ENABLED=false
INTERNSHALA_API_KEY=

# Pipeline Performance, Timeout, and Caching Controls
INTERNSHIP_SEARCH_CACHE_TTL_SECONDS=1800
INTERNSHIP_SOURCE_TIMEOUT_MS=7000
INTERNSHIP_SEARCH_MAX_CONCURRENCY=4
